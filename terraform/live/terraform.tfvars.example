# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# The token is the one value that must never be committed. Prefer an env var:
#   export TF_VAR_dash0_auth_token="auth_..."
# and leave it out of this file entirely.

# From app.dash0.com -> organization settings -> Endpoints -> OTLP/gRPC
dash0_otlp_grpc_endpoint = "ingress.us-west-2.aws.dash0.com:4317"

# From app.dash0.com -> organization settings -> Endpoints -> API
dash0_api_endpoint = "https://api.us-west-2.aws.dash0.com"

# From app.dash0.com -> organization settings -> Auth Tokens
# No "Bearer " prefix. Better supplied via TF_VAR_dash0_auth_token.
# dash0_auth_token = "auth_..."

# A dedicated dataset keeps demo noise out of "default".
dash0_dataset = "demo"

# Narrow this to your own IP. The default in variables.tf leaves the Kubernetes
# API endpoint reachable from anywhere (still authenticated, but wider than it
# needs to be). Find yours with: curl -s https://checkip.amazonaws.com
# api_allowed_cidrs = ["203.0.113.4/32"]

# Set once you have created the GitHub Actions OIDC role, so CI can reach the
# cluster. See docs/SETUP.md.
# ci_role_arn = "arn:aws:iam::111122223333:role/github-actions-dash0-lab"
