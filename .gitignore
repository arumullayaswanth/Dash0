# Terraform
**/.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
*.tfplan
tfplan
recovery.tfplan
plan.txt
plan.json
outputs.txt
.terraform.lock.hcl.bak

# CI runtime artifacts (generated by the workflow, never committed)
.ci/
dash0-verification.json
cleanup.json

# Backend config is account-specific
backend.hcl

# NEVER commit these. The Dash0 auth token and any real endpoint values live here.
*.tfvars
!env/*.tfvars
!**/env/*.tfvars
*.auto.tfvars
terraform.tfvars
secrets.tfvars

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
_validate_override.tf

# CLI config
.terraformrc
terraform.rc

# Kubeconfigs pulled down locally
kubeconfig
kubeconfig-*
*.kubeconfig

# Secrets, credentials, keys, tokens — NEVER commit
.env
.env.*
*.env
secrets.*
*secret*.json
*credentials*
*.pem
*.key
*.p12
*.pfx
*.pub
id_rsa*
id_ed25519*
*.token
*token.txt
aws-credentials*
.aws/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Local notes / scratch (may contain account IDs, ARNs, tokens)
notes.md
scratch.*
setup-note.*
_probe*.sh
tmp/
*.log
